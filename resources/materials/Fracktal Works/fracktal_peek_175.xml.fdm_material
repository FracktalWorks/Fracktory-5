<?xml version="1.0" encoding="UTF-8"?>
<!--
Generic PEEK 1.75mm profile. High-performance thermoplastic for demanding applications.
-->
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Fracktal Works</brand>
            <material>PEEK</material>
            <color>Generic</color>
            <label>PEEK</label>
        </name>
        <GUID>a3e52c8f-6d1b-4e9a-b5c7-9f8d2a4b6e10</GUID>
        <version>1</version>
        <reference_material_id>abs</reference_material_id>
        <color_code>#d4a574</color_code>
        <description>PEEK (Polyether Ether Ketone) is an ultra high-performance thermoplastic with excellent mechanical properties, chemical resistance, and thermal stability. Suitable for aerospace, medical, and industrial applications. Handles temperatures up to 250ºC continuously.</description>
        <adhesion_info>Use high-temp adhesive or PEI sheet</adhesion_info>
    </metadata>
    <properties>
        <density>1.3</density>
        <diameter>1.75</diameter>
        <weight>500</weight>
        <cost>15000</cost>
    </properties>
<!--
PEEK requires very high temperatures and slow print speeds for optimal layer adhesion.
-->
    <settings>
        <setting key="print temperature">420</setting>
        <setting key="standby temperature">320</setting>
        <setting key="heated bed temperature">180</setting>
        <setting key="build volume temperature">90</setting>
        <setting key="adhesion tendency">0</setting>
        <setting key="surface energy">70</setting>
        <cura:setting key="bridge_fan_speed">0</cura:setting>
        <cura:setting key="cool_fan_enabled">False</cura:setting>
        <cura:setting key="support_fan_enable">False</cura:setting>
        <cura:setting key="brim_line_count">10</cura:setting>
        <cura:setting key="speed_print">10</cura:setting>
        <cura:setting key="retraction_combing">all</cura:setting>
        <cura:setting key="speed_slowdown_layers">0</cura:setting>
        <cura:setting key="speed_layer_0">10</cura:setting>
        <cura:setting key="speed_topbottom">10</cura:setting>
        <cura:setting key="speed_wall">10</cura:setting>
        <cura:setting key="speed_wall_0">10</cura:setting>
        <cura:setting key="speed_wall_x">10</cura:setting>
        <cura:setting key="speed_support_bottom">10</cura:setting>
        <cura:setting key="speed_support_infill">10</cura:setting>
        <cura:setting key="speed_support_roof">10</cura:setting>
        <cura:setting key="speed_support_interface">10</cura:setting>
        <cura:setting key="skin_overlap">10</cura:setting>
        <cura:setting key="cool_min_layer_time">15</cura:setting>


   </settings>
</fdmmaterial>
