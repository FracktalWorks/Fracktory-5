<?xml version="1.0" encoding="UTF-8"?>
<!--
Generic PC 1.75mm profile. The data in this file may not be correct for your specific machine.
-->
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Fracktal Works</brand>
            <material>PC</material>
            <color>Generic</color>
        </name>
        <GUID>62414577-94d1-490d-b1e4-7ef3ec40db02</GUID>
        <reference_material_id>pc</reference_material_id>
        <version>6</version>
        <color_code>#F29030</color_code>
        <description>Strong, tough and temperature resistant. PC offers a great print quality, heat resistance up to 110ºC, mechanical strength and toughness.</description>
        <adhesion_info>Use glue for small prints. An adhesion sheet is recommended for larger prints. Set your print speed to a low value (10mm/sec) to get better layer bonding.</adhesion_info>
    </metadata>
    <properties>
        <density>1.19</density>
        <diameter>1.75</diameter>
        <weight>1000</weight>
        <cost>4500</cost>
    </properties>
<!--
If print speed is critical to the material printing, like if printing too fast will cause warping etc, then set the maximum print speed here that will be used for Balanced and Engineering intents. in the intents then set the print speed to be the maximum print speed for the material per nozzle size.
If the material is not speed critical, then leave this out to go the max machine speed.
-->
    <settings>
        <setting key="print temperature">270</setting>
        <setting key="standby temperature">175</setting>
        <setting key="heated bed temperature">110</setting>
        <setting key="build volume temperature">41</setting>
        <setting key="print cooling">0</setting>

        <cura:setting key="cool_fan_speed">0</cura:setting>
        <cura:setting key="cool_fan_speed_max">30</cura:setting>
        <cura:setting key="support_fan_enable">true</cura:setting>
        <cura:setting key="support_supported_skin_fan_speed">30</cura:setting>
        <cura:setting key="brim_line_count">10</cura:setting>
        <cura:setting key="speed_print">60</cura:setting>

        <machine>
            <machine_identifier manufacturer="Volterra ALF Series" product="volterra_300_alf" />
            <setting key="heated bed temperature">90</setting>
        </machine>

    </settings>
</fdmmaterial>
