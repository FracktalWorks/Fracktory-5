<?xml version="1.0" encoding="UTF-8"?>
<!--
Generic ABS 1.75mm profile. The data in this file may not be correct for your specific machine.
-->
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Fracktal Works</brand>
            <material>ABS</material>
            <color>Generic</color>
            <label>ABS+</label>
        </name>
        <GUID>2780b345-577b-4a24-a2c5-12e6aad6e690</GUID>
        <version>11</version>
        <reference_material_id>abs</reference_material_id>
        <color_code>#8cb219</color_code>
        <description>Tough and durable. ABS is good for mechanical parts. It is impact resistant, dimensionally stable and handles temperatures up to 85ºC.</description>
        <adhesion_info>No glue needed</adhesion_info>
    </metadata>
    <properties>
        <density>1.1</density>
        <diameter>1.75</diameter>
        <weight>1000</weight>
        <cost>2200</cost>
    </properties>
<!--
If print speed is critical to the material printing, like if printing too fast will cause warping etc, then set the maximum print speed here that will be used for Balanced and Engineering intents. in the intents then set the print speed to be the maximum print speed for the material per nozzle size.
If the material is not speed critical, then leave this out to go the max machine speed.
-->
    <settings>
        <setting key="print temperature">260</setting>
        <setting key="standby temperature">200</setting>
        <setting key="heated bed temperature">100</setting>
        <setting key="build volume temperature">60</setting>
        <setting key="adhesion tendency">0</setting>
        <setting key="surface energy">70</setting>
        <cura:setting key="cool_fan_speed">0</cura:setting>
        <cura:setting key="cool_fan_speed_max">30</cura:setting>
        <cura:setting key="support_fan_enable">true</cura:setting>
        <cura:setting key="support_supported_skin_fan_speed">30</cura:setting>
        <cura:setting key="brim_line_count">10</cura:setting>
        <cura:setting key="speed_print">60</cura:setting>
        <cura:setting key="strengthen_tree_support">true</cura:setting>

        <machine>
            <machine_identifier manufacturer="Volterra ALF Series" product="volterra_300_alf" />
            <setting key="heated bed temperature">80</setting>
            <cura:setting key="ring_heater_enable">False</cura:setting>
        </machine>

   </settings>
</fdmmaterial>
