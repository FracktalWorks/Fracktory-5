<?xml version="1.0" encoding="UTF-8"?>
<!--
Nylon Pellet profile for pellet extrusion printers.
-->
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Fracktal Works</brand>
            <material>Nylon</material>
            <color>Generic</color>
            <label>Nylon Pellet</label>
        </name>
        <GUID>db18bd4c-932e-44e4-bb45-d204f9671566</GUID>
        <reference_material_id>nylon</reference_material_id>
        <version>1</version>
        <color_code>#3DF266</color_code>
        <description>Nylon pellets for pellet extrusion. Strong, abrasion-resistant, and durable.</description>
        <adhesion_info>Use glue.</adhesion_info>
    </metadata>
    <properties>
        <density>1.14</density>
        <diameter>1.75</diameter>
    </properties>
    <settings>
        <setting key="print temperature">260</setting>
        <setting key="barrel temperature">190</setting>
        <setting key="standby temperature">175</setting>
        <setting key="heated bed temperature">90</setting>
        <setting key="build volume temperature">60</setting>
        <setting key="adhesion tendency">2</setting>
        <setting key="surface energy">100</setting>
        <cura:setting key="material_crystallinity">true</cura:setting>
        <cura:setting key="cool_fan_speed">0</cura:setting>
        <cura:setting key="cool_fan_speed_max">30</cura:setting>
    </settings>
</fdmmaterial>
