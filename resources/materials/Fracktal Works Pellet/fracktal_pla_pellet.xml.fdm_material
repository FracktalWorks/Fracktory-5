<?xml version="1.0" encoding="UTF-8"?>
<!--
PLA Pellet profile for pellet extrusion printers.
-->
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <metadata>
        <name>
            <brand>Fracktal Works</brand>
            <material>PLA</material>
            <color>Generic</color>
            <label>PLA Pellet</label>
        </name>
        <GUID>090df1a6-e84b-4489-9f3b-f2dce5246697</GUID>
        <reference_material_id>pla</reference_material_id>
        <version>1</version>
        <color_code>#ffc934</color_code>
        <description>PLA pellets for pellet extrusion. Ideal for fast, reliable printing with great surface quality.</description>
        <adhesion_info>Print directly on PEI flex build plate</adhesion_info>
    </metadata>
    <properties>
        <density>1.24</density>
        <diameter>1.75</diameter>
    </properties>
    <settings>
        <setting key="print temperature">190</setting>
        <setting key="standby temperature">175</setting>
        <setting key="heated bed temperature">60</setting>
        <setting key="build volume temperature">30</setting>
        <setting key="print cooling">100</setting>
        <setting key="adhesion tendency">0</setting>
        <setting key="surface energy">100</setting>
        <cura:setting key="cool_fan_speed">100</cura:setting>
        <cura:setting key="cool_fan_speed_max">100</cura:setting>
    </settings>
</fdmmaterial>
