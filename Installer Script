# Script Configuration
$PYTHON_VERSION = "3.11.7"
$CONAN_VERSION = "1.65.0"
$CURA_VERSION = "5.9.1"
$WORKSPACE_DIR = $PSScriptRoot

# Function to check if a command exists
function Test-CommandExists {
    param ($command)
    $exists = Get-Command -Name $command -ErrorAction SilentlyContinue
    return ($null -ne $exists)
}

# Function to check and install Python
function Install-Python {
    if (-not (Test-CommandExists "python")) {
        Write-Host "Python not found. Please install Python $PYTHON_VERSION from python.org"
        exit 1
    }
    python -m pip install --upgrade pip setuptools wheel
}

# Function to check and install required tools
function Install-RequiredTools {
    # Check NSIS
    if (-not (Test-Path "C:\Program Files (x86)\NSIS")) {
        Write-Host "NSIS not found. Please install NSIS from https://nsis.sourceforge.io/Download"
        exit 1
    }

    # Check WiX Toolset
    if (-not (Test-Path "C:\Program Files (x86)\WiX Toolset v3.14")) {
        Write-Host "WiX Toolset not found. Please install WiX Toolset v3.14 from https://wixtoolset.org/releases/"
        exit 1
    }
}

# Function to setup environment variables
function Set-BuildEnvironment {
    $env:NSIS_PATH = "C:\Program Files (x86)\NSIS"
    $env:WIX_PATH = "C:\Program Files (x86)\WiX Toolset v3.14\bin"
    $env:Path += ";$env:NSIS_PATH;$env:WIX_PATH"
}

# Function to setup Conan
function Setup-Conan {
    pip install conan==$CONAN_VERSION
    git clone https://github.com/ultimaker/conan-config.git
    Push-Location conan-config
    git checkout 3226488623c642b40ca7ce3f33de046d11e
    Pop-Location
    conan config install ./conan-config
    conan remote remove cura-private -f
}

# Function to build CuraEngine
function Build-CuraEngine {
    git clone https://github.com/FracktalWorks/CuraEngine.git
    Push-Location CuraEngine
    git pull
    conan remove --locks
    conan create . curaengine/$CURA_VERSION@FracktalWorks/stable --build=missing --update
    Pop-Location
}

# Function to build Cura
function Build-Cura {
    # Install dependencies
    pip install -r .github/workflows/requirements-runner.txt

    # Create Conan package
    conan create . local/test --build=missing --update -c tools.build:skip_test=True

    # Install Cura with dependencies
    conan install cura/$CURA_VERSION@local/test --require-override=curaengine/$CURA_VERSION@FracktalWorks/stable --build=missing --update -if cura_inst -g VirtualPythonEnv -o cura:enterprise=False -o cura:staging=False -o cura:internal=False -c tools.build:skip_test=True -s curaengine:build_type=RelWithDebInfo -s arcus:build_type=RelWithDebInfo -s clipper:build_type=RelWithDebInfo

    # Activate environment
    & .\cura_inst\Scripts\activate_github_actions_env.ps1
    & .\cura_inst\Scripts\activate_github_actions_version_env.ps1

    # Create distribution
    pyinstaller ./cura_inst/Fracktory.spec
}

# Function to create installers
function Create-Installers {
    # Create EXE installer
    python cura_inst\packaging\NSIS\create_windows_installer.py cura_inst dist "Fracktory-$CURA_VERSION.exe"

    # Create MSI installer
    python cura_inst\packaging\msi\create_windows_msi.py cura_inst dist\Fracktory "Fracktory-$CURA_VERSION.msi" "Fracktory"
}

# Main execution
try {
    Write-Host "Starting build process..."
    
    Install-Python
    Install-RequiredTools
    Set-BuildEnvironment
    Setup-Conan
    Build-CuraEngine
    Build-Cura
    Create-Installers

    Write-Host "Build completed successfully!"
    Write-Host "Installers can be found in the 'dist' directory:"
    Write-Host "- Fracktory-$CURA_VERSION.exe"
    Write-Host "- Fracktory-$CURA_VERSION.msi"
} catch {
    Write-Host "Error occurred during build process: $_"
    exit 1
}